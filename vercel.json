{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/index.js" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" },
    { "source": "/favicon.svg", "destination": "/frontend/favicon.svg" },
    { "source": "/manifest.json", "destination": "/frontend/manifest.json" },
    { "source": "/:path*", "destination": "/frontend/index.html" }
  ]
}
